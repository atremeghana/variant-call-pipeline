# Pipeline configuration — no secrets here.
#
# REFERENCE_FASTA / CALL_REGION are the canonical names. REF / REGION are
# accepted as short aliases for the same two values, both here and in the
# environment, so the brief's smoke command works unchanged:
#
#   cd smoke
#   REF=$PWD/smoke.fa REGION=smoke_1mb bash /path/to/run_pipeline.sh samplesheet.csv /path/to/out
#
# The environment always wins over this file. Only these two values change
# between the laptop smoke run and next week's real run on Explorer.

# --- next week, on Explorer: the whole GRCh38, NOT a chr20 subset ---
REFERENCE_FASTA=""       # /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa
CALL_REGION="chr20:1-10000000"

# --- this week, on a laptop: the smoke dataset ---
# Left commented out because the brief passes them in the environment instead.
# REF="$PWD/smoke.fa"
# REGION="smoke_1mb"

THREADS=4
