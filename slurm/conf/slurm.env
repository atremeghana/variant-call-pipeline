# slurm.env - everything specific to Explorer, so that no .sbatch script in this
# directory contains a path and no file in lib/ or stages/ contains any Slurm.
# Change machine, change this file.
#
# conf/pipeline.env (repository root) holds WHAT to analyse - reference, region.
# This file holds WHERE to run it, WHO to bill, and HOW BIG the allocation is.
#
# Sourced by both .sbatch scripts and by submit.sh. Plain assignments only: it
# is read by `source`, so anything with a side effect would run inside every job.

# --- who and where ---
PARTITION=courses
ACCOUNT=binf6610.202710

# --export=NONE means the job inherits almost nothing, so $USER is not
# necessarily set by the time the paths below are expanded. Both RUN_ROOT and
# any scratch path depend on it, and an unset $USER under `set -u` would take
# the job down before it logged anything.
USER=${USER:-$(id -un)}

# --- paths ---
# The repository, as cloned on Explorer. run_sample.sh and run_cohort.sh are
# invoked from here rather than from $SLURM_SUBMIT_DIR, so the jobs do not care
# which directory you submitted from as long as conf/slurm.env is in it.
PIPELINE_DIR=${HOME}/variant-call-pipeline
SIF=/scratch/${USER}/containers/variant-call.sif

# The eight-sample cohort sheet as shipped by the course. Ten columns; the
# pipeline reads the six it needs by name and ignores the rest.
SAMPLESHEET=/courses/BINF6610.202710/data/samplesheet-variant8.csv

# Where this run writes. /scratch is the large filesystem: BAMs, the sorted and
# deduplicated copies of them, and the GenomicsDB workspace all belong there
# rather than in $HOME, which has a quota this cohort would exceed.
#
# NOTE: /scratch is purged periodically. Nothing under RUN_ROOT is permanent,
# so copy anything you need to keep (results/, manifest.json) somewhere durable
# before the purge. There is deliberately no automatic copy-out step here yet -
# see RESOURCES.md.
RUN_ROOT=/scratch/${USER}/w2-run

# The course's shared conda environment. Both .sbatch scripts activate it; it is
# named here so that neither of them has the path written into it.
CONDA_ENV=/courses/BINF6610.202710/shared/env/binf6610

# --- allocation sizes ---
# submit.sh passes these to sbatch on the command line, where they override the
# #SBATCH defaults baked into the .sbatch files. That indirection exists because
# #SBATCH directives are parsed before the job runs and so cannot read a
# variable from here - it is the only way one file can set both.
#
# EVERY NUMBER BELOW IS STILL A GUESS. None has been measured with seff/sacct on
# a real Explorer run. RESOURCES.md is where the measurements go and where these
# values get their justification; until it is filled in, do not treat them as
# tuned and do not quote them as if they were.

# --- per-sample array task (one sample, stages 0-5) ---
PERSAMPLE_CPUS=8
PERSAMPLE_MEM="20G"
PERSAMPLE_TIME="00:30:00"

# Cap how many array tasks run at once. Empty means no cap. Worth setting if the
# shared filesystem, rather than the CPU allocation, turns out to be the limit.
ARRAY_THROTTLE=""

# --- cohort job (all samples, once, stages 6-9) ---
COHORT_CPUS=4
COHORT_MEM="8G"
COHORT_TIME="00:20:00"
