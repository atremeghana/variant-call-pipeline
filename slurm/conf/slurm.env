# slurm.env - scheduler resources, separate from the science config.
#
# conf/pipeline.env holds WHAT to analyse (reference, call region).
# This file holds WHERE and HOW BIG to run it. Nothing here names an analysis
# tool: the orchestration layer only ever calls run_sample.sh / run_cohort.sh.
#
# These are PLACEHOLDERS. Every number below is a guess until it has been
# measured with `seff` / `sacct` on a real run and recorded in RESOURCES.md.
# Do not treat them as tuned.
#
# submit.sh sources this file and passes the values to sbatch on the command
# line, where they override the #SBATCH defaults baked into the .sbatch files.
# That indirection exists because #SBATCH directives are parsed before the job
# runs and so cannot read a variable from here.

# --- where ---
PARTITION="short"

# --- per-sample array task (one sample) ---
PERSAMPLE_CPUS=8
PERSAMPLE_MEM="32G"
PERSAMPLE_TIME="04:00:00"

# Cap how many array tasks run at once. Empty means no cap. Useful when the
# shared filesystem, not the CPU allocation, is the bottleneck.
ARRAY_THROTTLE=""

# --- cohort job (all samples, once) ---
COHORT_CPUS=4
COHORT_MEM="24G"
COHORT_TIME="02:00:00"

# --- paths, relative to the submit directory ---
SAMPLESHEET_FILE="samplesheet.csv"
PIPELINE_OUTDIR="results"
