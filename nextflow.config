manifest {
    name    = 'variant-call'
    version = '1.0.0'
}

params {
    samplesheet = null
    ref         = null
    region      = null
    outdir      = 'results'
    platform    = 'laptop'

    // The software: one public image per kind of step, each pinned to the
    // version the course conda environment has.
    containers = [
        tools  : 'community.wave.seqera.io/library/coreutils_gawk_gzip:7c58ccc2f9ca6bcc',  // stages 0, 9
        fastqc : 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0',
        fastp  : 'community.wave.seqera.io/library/fastp:1.3.7--075357a9d5c82494',
        bwa    : 'community.wave.seqera.io/library/bwa_samtools:22527ddb3cc80fb3',
        gatk   : 'community.wave.seqera.io/library/gatk4_samtools_bcftools:1adede7d418fb46b',
        multiqc: 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_2'
    ]
}

outputDir            = params.outdir
workflow.output.mode = 'copy'

process {
    cpus   = 1
    memory = '2 GB'
    shell  = ['/bin/bash', '-euo', 'pipefail']
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    fields    = 'task_id,name,status,exit,container,native_id,realtime,%cpu,peak_rss'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}

profiles {
    docker {
        params.platform   = 'docker-local'
        docker.enabled    = true
        docker.runOptions = '--platform linux/amd64'
    }
    explorer {
        params.platform = 'singularity-hpc'
        process {
            executor       = 'slurm'
            queue          = 'courses'
            clusterOptions = '--account=binf6610.202710'
            time           = '30m'
            withName: 'BWA_MEM|HAPLOTYPECALLER' {
                cpus   = 8
                memory = '16 GB'
                time   = '1h'
            }
            withName: 'HAPLOTYPECALLER' {
                time = '1h'    // restored after Failure 4's deliberate test
            }

            withName: 'MARKDUPLICATES|JOINT_GENOTYPE|FILTER' {
                cpus   = 2
                memory = '8 GB'
                time   = '1h'
            }
        }
        apptainer {
            enabled    = true
            autoMounts = true
        }
    }

    awsbatch {
        params.platform = 'aws-batch'
        workDir         = 's3://binf6610-atrem/work'
        process {
            executor = 'awsbatch'
            queue    = 'binf6610-queue'
        }
        aws {
            region = 'us-east-2'
            batch {
                platformType  = 'fargate'
                jobRole       = "arn:aws:iam::${env('AWS_ACCOUNT_ID')}:role/binf6610-batch-job"
                executionRole = "arn:aws:iam::${env('AWS_ACCOUNT_ID')}:role/binf6610-batch-execution"
            }
        }
        wave.enabled = true      // on Fargate, Wave adds what each task needs to reach S3
    }
}
